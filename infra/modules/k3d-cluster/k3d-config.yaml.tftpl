apiVersion: k3d.io/v1alpha5
kind: Simple
metadata:
  name: ${cluster_name}
# Pinned explicitly (ADR-0030) -- k3d otherwise silently uses whatever k3s version
# is bundled with the installed k3d CLI, breaking "recreate-from-code" reproducibility
# and leaving k3s out of the weekly architect CVE sweep (nothing was on record to
# check). Docker Hub tag format uses a hyphen; INSTALL_K3S_VERSION (oracle backend,
# infra/modules/oracle-k3s-cluster/cloud-init.yaml) uses "+" for the same version --
# keep both in sync on a future bump.
image: rancher/k3s:v1.36.3-k3s1
servers: ${servers}
agents: ${agents}
kubeAPI:
  hostPort: "${api_port}"
ports:
  - port: ${http_port}:80
    nodeFilters:
      - loadbalancer
  - port: ${https_port}:443
    nodeFilters:
      - loadbalancer
%{ if disable_traefik || disable_default_cni ~}
options:
  k3s:
    extraArgs:
%{ if disable_traefik ~}
      - arg: --disable=traefik
        nodeFilters:
          - server:*
%{ endif ~}
%{ if disable_default_cni ~}
      - arg: --flannel-backend=none
        nodeFilters:
          - server:*
      - arg: --disable-network-policy
        nodeFilters:
          - server:*
%{ endif ~}
%{ endif ~}
