apiVersion: k3d.io/v1alpha5
kind: Simple
metadata:
  name: ${cluster_name}
servers: ${servers}
agents: ${agents}
kubeAPI:
  hostPort: "${api_port}"
ports:
  - port: ${http_port}:80
    nodeFilters:
      - loadbalancer
  - port: ${https_port}:443
    nodeFilters:
      - loadbalancer
%{ if disable_traefik || disable_default_cni ~}
options:
  k3s:
    extraArgs:
%{ if disable_traefik ~}
      - arg: --disable=traefik
        nodeFilters:
          - server:*
%{ endif ~}
%{ if disable_default_cni ~}
      - arg: --flannel-backend=none
        nodeFilters:
          - server:*
      - arg: --disable-network-policy
        nodeFilters:
          - server:*
%{ endif ~}
%{ endif ~}
