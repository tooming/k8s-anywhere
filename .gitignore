# Terraform / Terragrunt
**/.terraform/*
.terraform.lock.hcl
*.tfstate
*.tfstate.*
.terragrunt-cache/
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Kubeconfig / secrets — never commit these
kubeconfig
*.kubeconfig
.env
.env.*
/secrets/
infra/secrets/
*.pem
*.key
*-key.pem

# GitLab omnibus runtime data (bind-mounted)
gitlab/data/
gitlab/logs/
gitlab/tls/
gitlab/config/
gitlab/.gitlab-token
gitlab/runner-config/

# Forgejo runtime data (bind-mounted) — ADR-0035
forgejo/runner-config/
forgejo/.forgejo-token

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
