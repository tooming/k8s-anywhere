#!/usr/bin/env bash
# Pre-push hook: run the fast local lint gate (shellcheck + yamllint, seconds)
# before every push. The full clusterless CI gate (bats/kustomize/terraform/
# drift checks — everything `make ci` runs) lives in GitHub Actions
# (.github/workflows/ci.yml `drift`/`unit`/`manifests`/`terraform`/`kustomize`
# jobs) and runs on the pushed branch/PR instead — it's the full backstop now,
# not just a mirror of this hook. Run `make ci` locally any time you want the
# full suite before pushing.
#
# Install once per clone:  make install-hooks
# Skip in emergencies:     git push --no-verify
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -t 1 ]; then
  B=$'\033[1m'; R=$'\033[31m'; G=$'\033[32m'; Z=$'\033[0m'
else
  B=; R=; G=; Z=
fi

# Check that the branch is on top of <remote>/main before pushing.
# Git passes the push destination as $1 — no remote detection needed.
# Catches the case where main moved while we were working and the branch was
# never rebased — auto-update-prs only fires on main pushes, so if no PR was
# open at that moment the branch can silently drift behind.
REMOTE=${1:-origin}
git fetch "$REMOTE" main -q 2>/dev/null || true

# Git feeds the refs being pushed on stdin as
# "<local ref> <local oid> <remote ref> <remote oid>" lines. Capture them once:
# every guard below keys off what is ACTUALLY being pushed — never off the
# checked-out branch, which can be unrelated (e.g. `make gitlab-push` pushes
# main while a feature branch is checked out).
PUSH_REFS="$(cat)"

# Refuse to push to a branch whose PR is already MERGED (stray-commit-on-a-dead-
# branch guard). Check each non-deletion head ref. Enforced only where gh is
# available (degrades to a no-op otherwise — see scripts/check-merged-pr-push.sh).
merged_pr_block=0
while read -r _localref localoid remoteref _remoteoid; do
  [[ -z "${remoteref:-}" ]] && continue
  case "$remoteref" in refs/heads/*) br="${remoteref#refs/heads/}" ;; *) continue ;; esac
  [[ "$localoid" =~ ^0+$ ]] && continue          # branch deletion — allow
  if ! bash "$ROOT/scripts/check-merged-pr-push.sh" "$br"; then
    merged_pr_block=1
  fi
done <<< "$PUSH_REFS"
if [[ "$merged_pr_block" -eq 1 ]]; then
  echo ""
  echo "${R}${B}[pre-push] Push targets a MERGED PR branch — blocked.${Z}"
  echo "Create a new branch + PR for the follow-up work."
  echo "To skip (emergencies only): git push --no-verify"
  exit 1
fi

# Behind-main guard: block pushing a feature branch whose history is missing
# commits from <remote>/main. Judged per PUSHED ref (stdin), not the checked-out
# branch — pushing main itself is exempt.
behind_block=0
while read -r _localref localoid remoteref _remoteoid; do
  [[ -z "${remoteref:-}" ]] && continue
  case "$remoteref" in refs/heads/*) br="${remoteref#refs/heads/}" ;; *) continue ;; esac
  [[ "$br" == "main" ]] && continue              # pushing main itself — exempt
  [[ "$localoid" =~ ^0+$ ]] && continue          # branch deletion — allow
  MERGE_BASE=$(git merge-base "$localoid" "$REMOTE/main" 2>/dev/null || true)
  MAIN_HEAD=$(git rev-parse "$REMOTE/main" 2>/dev/null || true)
  if [[ -n "$MERGE_BASE" && -n "$MAIN_HEAD" && "$MERGE_BASE" != "$MAIN_HEAD" ]]; then
    BEHIND=$(git log --oneline "${MERGE_BASE}..${REMOTE}/main" | wc -l | tr -d ' ')
    echo ""
    echo "${R}${B}[pre-push] Branch ${br} is ${BEHIND} commit(s) behind main — push blocked.${Z}"
    echo "Rebase first:  git fetch $REMOTE && git rebase $REMOTE/main"
    echo "Or rebase all: make rebase-prs PUSH=1"
    echo "To skip (emergencies only): git push --no-verify"
    behind_block=1
  fi
done <<< "$PUSH_REFS"
if [[ "$behind_block" -eq 1 ]]; then
  exit 1
fi

echo "${B}[pre-push] Running fast lint gate (shellcheck + yamllint)…${Z}"

if make -C "$ROOT" lint; then
  echo "${G}[pre-push] Lint passed — push proceeding. Full make ci (bats/kustomize/terraform/drift) runs in GitHub Actions.${Z}"
  exit 0
else
  echo ""
  echo "${R}${B}[pre-push] Lint FAILED — push blocked.${Z}"
  echo "Fix the errors above, then push again."
  echo "Run the full local suite any time with: make ci"
  echo "To skip (emergencies only): git push --no-verify"
  exit 1
fi
