{
  "uid": "lab-stack-health",
  "title": "Lab — Stack Health",
  "tags": ["lab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 10, "type": "text", "title": "Lab UIs",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "options": { "mode": "markdown", "content": "| Service | URL | Role |\n|---|---|---|\n| **ArgoCD** | http://argocd.127.0.0.1.nip.io:8000 | GitOps engine |\n| **Grafana** | http://localhost:8000 | Dashboards (here) |\n| **Vault** | http://vault.127.0.0.1.nip.io:8000 | Secrets |\n| **GitLab** | http://localhost:8929 | Git source |\n| **S3 browser** | http://s3.127.0.0.1.nip.io:8000 | Browse Garage buckets |\n| **moto** | http://moto.127.0.0.1.nip.io:8000/moto-api/ | AWS mock |\n| **TiDB Demo** | http://tidb-demo.127.0.0.1.nip.io:8000 | TiDB demo app (on-demand) |\n| **RabbitMQ** | http://rabbitmq.127.0.0.1.nip.io:8000 | Message broker management UI |\n| **Artifactory** | http://artifactory.127.0.0.1.nip.io:8000 | On-demand artifact registry (on-demand) |\n| **Kiali** | http://kiali.127.0.0.1.nip.io:8000 | Service mesh UI (on-demand) |\n| **Longhorn** | http://longhorn.127.0.0.1.nip.io:8000 | Block storage UI (on-demand) |\n| **Capstone** | http://capstone.127.0.0.1.nip.io:8000 | Capstone demo app (pipeline-built image) |\n| **Argo Rollouts** | http://rollouts.127.0.0.1.nip.io:8000 | Progressive delivery dashboard |\n\n_In-cluster UIs are reached via the stable **front door on :8000**, which routes to the active cluster regardless of blue/green (`*.127.0.0.1.nip.io`, no /etc/hosts). GitLab is a standalone container on its own port._" }
    },
    {
      "id": 1, "type": "stat", "title": "ArgoCD Apps",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "count(argocd_app_info)", "instant": true } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 2, "type": "stat", "title": "Apps Healthy",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "count(argocd_app_info{health_status=\"Healthy\"})", "instant": true } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 3, "type": "stat", "title": "Apps Synced",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "count(argocd_app_info{sync_status=\"Synced\"})", "instant": true } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 4, "type": "stat", "title": "Pods Running",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_pod_status_phase{phase=\"Running\"})", "instant": true } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 5, "type": "timeseries", "title": "Pods by phase",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum by (phase) (kube_pod_status_phase)", "legendFormat": "{{phase}}", "range": true } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6, "type": "table", "title": "ArgoCD Applications (live)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "argocd_app_info", "instant": true, "format": "table" } ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true, "dest_server": true, "dest_namespace": true, "namespace": true, "project": true, "repo": true, "operation": true, "autosync_enabled": true }, "renameByName": { "name": "Application", "health_status": "Health", "sync_status": "Sync" } } }
      ],
      "options": { "showHeader": true }
    }
  ]
}

