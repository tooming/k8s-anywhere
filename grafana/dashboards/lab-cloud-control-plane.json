      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(container_memory_working_set_bytes{namespace=\"moto\", container!=\"\"}) / 1024 / 1024", "instant": true } ],
      "fieldConfig": {
        "defaults": { "decimals": 1, "noValue": "n/a" },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
