      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "dest_server": true,
              "dest_namespace": true,
              "namespace": true,
              "project": true,
              "repo": true,
              "operation": true,
              "autosync_enabled": true
            },
            "renameByName": {
              "name": "Application",
              "health_status": "Health",
              "sync_status": "Sync"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      }
