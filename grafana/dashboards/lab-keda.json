      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (scaledObject) (rate(keda_scaled_object_errors_total[5m]))",
          "range": true,
          "legendFormat": "{{scaledObject}}"
