{
  "uid": "lab-kargo",
  "title": "Lab — Kargo (GitOps Promotion)",
  "tags": ["lab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Kargo API Running",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max(kube_deployment_status_replicas_available{namespace=\"kargo\",deployment=~\"kargo-api.*\"})", "instant": true } ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } } ],
          "noValue": "not deployed"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 2, "type": "stat", "title": "Kargo Controller Running",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max(kube_deployment_status_replicas_available{namespace=\"kargo\",deployment=~\"kargo-controller.*\"})", "instant": true } ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } } ],
          "noValue": "not deployed"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 3, "type": "stat", "title": "Kargo Memory (MiB)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(container_memory_working_set_bytes{namespace=\"kargo\", container!=\"\"}) / 1024 / 1024", "instant": true } ],
      "fieldConfig": {
        "defaults": { "decimals": 1, "noValue": "n/a", "unit": "short" },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 4, "type": "stat", "title": "Kargo ArgoCD Synced",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "argocd_app_info{name=\"kargo-extras\", sync_status=\"Synced\"}", "instant": true } ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "value", "options": { "1": { "text": "Synced" } } } ],
          "noValue": "OutOfSync"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 5, "type": "text", "title": "About",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 4 },
      "options": {
        "mode": "markdown",
        "content": "**Kargo** (ADR-0023) orchestrates GitOps promotion pipelines: a Warehouse polls the OCI registry for new image digests, creates Freight, and promotes it through dev → prod Stages via ArgoCD updates.\n\nThis is an **on-demand** component — bring it up with `make kargo-up`. Panels show \"No data\" or \"not deployed\" naturally when Kargo is not running (ADR-0004). Metrics come from the controller-runtime Prometheus endpoint at `:8080/metrics` on the `kargo-api` Service."
      }
    },
    {
      "id": 6, "type": "timeseries", "title": "Stage reconcile rate /s",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum by (result) (rate(controller_runtime_reconcile_total{job=\"kargo\",controller=~\"stage.*\"}[5m]))", "legendFormat": "stage · {{result}}", "range": true }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal", "group": "A" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Warehouse reconcile rate /s (produces Freight — Kargo has no dedicated Freight controller)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum by (result) (rate(controller_runtime_reconcile_total{job=\"kargo\",controller=~\"warehouse.*\"}[5m]))", "legendFormat": "warehouse · {{result}}", "range": true }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
