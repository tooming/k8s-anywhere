{
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/adr-context-hook.sh",
            "timeout": 15,
            "statusMessage": "Loading architecture decisions (ADRs)"
          },
          {
            "type": "command",
            "command": "make install-hooks",
            "timeout": 10,
            "statusMessage": "Wiring git pre-push hook"
          },
          {
            "type": "command",
            "command": "make rebase-prs PUSH=1",
            "timeout": 120,
            "statusMessage": "Rebasing open PR branches onto main (PRs merge on GitHub, so post-merge hook never fires — catch up here)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/readme-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking README sync"
          },
          {
            "type": "command",
            "command": "bash scripts/lab-ui-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking Lab UIs sync"
          },
          {
            "type": "command",
            "command": "bash scripts/roadmap-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking ROADMAP planner-note sync"
          },
          {
            "type": "command",
            "command": "bash scripts/markdown-links-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking markdown internal links"
          },
          {
            "type": "command",
            "command": "bash scripts/ci-parity-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking make ci / GitHub Actions parity"
          },
          {
            "type": "command",
            "command": "bash scripts/securitycontext-tests-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking securitycontext.bats freeze"
          },
          {
            "type": "command",
            "command": "bash scripts/networkpolicy-tests-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking networkpolicy.bats split"
          },
          {
            "type": "command",
            "command": "bash scripts/observability-tests-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking observability.bats freeze"
          },
          {
            "type": "command",
            "command": "bash scripts/yq-raw-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking bats yq usage"
          },
          {
            "type": "command",
            "command": "bash scripts/adr-guard-hook.sh",
            "timeout": 15,
            "statusMessage": "Checking ADR compliance"
          },
          {
            "type": "command",
            "command": "bash scripts/routines-sync-hook.sh",
            "timeout": 15,
            "statusMessage": "Checking routines sync"
          },
          {
            "type": "command",
            "command": "bash scripts/helm-chart-pin-sync-hook.sh",
            "timeout": 60,
            "statusMessage": "Checking Helm chart-version pin exists"
          },
          {
            "type": "command",
            "command": "bash scripts/argocd-crd-ssa-sync-hook.sh",
            "timeout": 90,
            "statusMessage": "Checking oversized-CRD Application uses server-side apply"
          },
          {
            "type": "command",
            "command": "bash scripts/rollouts-plugin-list-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking Argo Rollouts plugin values are lists"
          },
          {
            "type": "command",
            "command": "bash scripts/mimir-readonly-root-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking Mimir write paths are writable"
          },
          {
            "type": "command",
            "command": "bash scripts/adr-followup-sync-hook.sh",
            "timeout": 15,
            "statusMessage": "Checking ADR follow-up notes"
          },
          {
            "type": "command",
            "command": "bash scripts/adr-chart-version-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking ADR chart-version sync"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/merge-ci-gate-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking merged PR's CI status"
          }
        ]
      },
      {
        "matcher": "mcp__github__issue_write|mcp__github__add_issue_comment",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/idle-issue-guard-hook.sh",
            "timeout": 15,
            "statusMessage": "Checking idle-claim evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/commit-reminder-hook.sh",
            "timeout": 15,
            "statusMessage": "Checking commit + push"
          }
        ]
      }
    ]
  }
}
