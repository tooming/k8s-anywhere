{
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/adr-context-hook.sh",
            "timeout": 15,
            "statusMessage": "Loading architecture decisions (ADRs)"
          },
          {
            "type": "command",
            "command": "make install-hooks",
            "timeout": 10,
            "statusMessage": "Wiring git pre-push hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/readme-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking README sync"
          },
          {
            "type": "command",
            "command": "bash scripts/lab-ui-sync-hook.sh",
            "timeout": 30,
            "statusMessage": "Checking Lab UIs sync"
          },
          {
            "type": "command",
            "command": "bash scripts/adr-guard-hook.sh",
            "timeout": 15,
            "statusMessage": "Checking ADR compliance"
          },
          {
            "type": "command",
            "command": "bash scripts/routines-sync-hook.sh",
            "timeout": 15,
            "statusMessage": "Checking routines sync"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/commit-reminder-hook.sh",
            "timeout": 15,
            "statusMessage": "Checking commit + push"
          }
        ]
      }
    ]
  }
}
